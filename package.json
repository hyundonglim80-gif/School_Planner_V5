{
  "name": "school-planner-v5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emu",
    "build": "tsc -b && vite build",
    "build:emu": "tsc -b && vite build --mode emu",
    "preview": "vite preview",
    "test": "vitest run",
    "test:data": "vitest run --config vitest.data.config.ts",
    "lint": "oxlint",
    "emu": "firebase emulators:start --only auth,firestore --project schoolplannerv3",
    "seed": "node tools/seed.mjs",
    "check:rules": "node tools/check-rules.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "idb": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.0.0",
    "firebase-tools": "^15.30.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "re2": false
  }
}
