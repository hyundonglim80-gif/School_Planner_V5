{
  "name": "school-planner-v5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emu",
    "build": "tsc -b && vite build",
    "build:emu": "tsc -b && vite build --mode emu",
    "preview": "vite preview",
    "test": "vitest run",
    "test:data": "vitest run --config vitest.data.config.ts",
    "test:functions": "node --test functions/alarmPlan.test.js functions/claudePlan.test.js functions/chatPlan.test.js functions/pushPlan.test.js",
    "lint": "oxlint",
    "emu": "firebase emulators:start --only auth,firestore --project schoolplannerv3",
    "seed": "node tools/seed.mjs",
    "check:rules": "node tools/check-rules.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "idb": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.36.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "re2": false
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "firebase-tools": {
      "gaxios": {
        "uuid": "^11.1.1"
      }
    }
  }
}
