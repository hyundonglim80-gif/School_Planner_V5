rules_version = '2';

// ┌──────────────────────────────────────────────────────────────────────┐
// │ V5 규칙 (프로젝트 schoolplannerv3의 기본 데이터베이스).                │
// │                                                                      │
// │ 11-11 P31 사용자 'V4와 끊기': V3·V4 자리(users·groups·inviteCodes)의  │
// │ 규칙을 지웠다 - 그 문서는 서버에 그대로 있지만 앱은 아무도 읽고 쓰지  │
// │ 못한다(규칙에 없는 자리 = 기본 거부). V4 가져오기도 V5에서 뗐다.      │
// │                                                                      │
// │ 고칠 때마다 반드시 돌릴 것:  npm run check:rules                      │
// │   에뮬레이터에서 되어야 하는 일과 막혀야 하는 일을 하나씩 해 본다.     │
// │   눈으로만 읽으면 놓친다('구성원이면 누구나 그룹을 지울 수 있다'는    │
// │   구멍을 이 검사가 잡았다).                                            │
// │                                                                      │
// │ 배포(사용자에게 묻고):                                                 │
// │   npx firebase deploy --only firestore:rules --project schoolplannerv3│
// └──────────────────────────────────────────────────────────────────────┘

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 등록된 개발자 계정. src/domain/developers.ts 와 같은 목록을 유지해야 한다.
    function isDeveloper() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in [
        'hyundonglim@gmail.com',
        'hyundonglim80@gmail.com',
        'hyundonglim.work@gmail.com'
      ];
    }

    // ── 공휴일 (모두가 같이 보는 자료) ─────────────────────────────────
    // 개발자가 1년에 한 번 공공데이터포털에서 받아 여기에 적어둔다.
    // 사용자는 읽기만 하므로 API 키를 발급받을 필요도, 가질 필요도 없다.
    match /holidays/{year} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    // ── 개발자 전용 설정 ───────────────────────────────────────────────
    // 공공데이터 API 키가 들어 있다. 소스에 두면 빌드 결과물에 실려
    // 누구나 꺼내 쓸 수 있으므로, 읽기까지 개발자로 제한한다.
    match /admin/{document=**} {
      allow read, write: if isDeveloper();
    }

    // ── 모두가 읽는 설정 (나이스 키) ───────────────────────────────────
    // 나이스 급식·학사일정은 학교마다 달라 공휴일처럼 개발자가 받아 둘 수 없다. 사용자 브라우저가
    // 이 키로 open.neis.go.kr을 직접 부른다(src/data/neis.ts). 그래서 로그인한 사람은 읽는다 -
    // 네트워크 요청에도 보이므로 막히면 키를 새로 받아 여기만 바꾼다. 쓰기는 개발자만.
    // 키가 없거나 못 읽으면 앱이 키 없이(한 번에 5건씩 나눠) 부른다.
    match /sharedConfig/{doc} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    // ══════════════════════════════════════════════════════════════════
    // V5 — spaces · spaceInvites · v5alarms · v5Errors · v5Mail · v5Chat · v5Dm · v5ChatReads
    //
    // 공간 = 개인 `u_{uid}`(그 사람만) 또는 그룹 `g_{id}`(구성원만).
    // 구성원은 맵 members: { uid: 'owner' | 'member' }.
    // 자세히는 V5 docs/DESIGN.md 4-1·4-9.
    // ══════════════════════════════════════════════════════════════════

    // 내 개인 공간 id인가. 문서를 읽지 않고 이름만으로 안다.
    function isMySpaceId(sid) {
      return signedIn() && sid == 'u_' + request.auth.uid;
    }

    // 공간 문서(data)의 구성원인가. 문서가 없으면 오류 = 거부.
    function isSpaceMember(data) {
      return signedIn() && data.members[request.auth.uid] in ['owner', 'member'];
    }

    match /spaces/{sid} {
      // 내 개인 공간은 문서가 없어도 읽어 본다(없으면 로그인할 때 만든다).
      allow get: if isMySpaceId(sid) || isSpaceMember(resource.data);
      // 내 공간 목록은 where('members.<uid>', 'in', ['owner', 'member'])로만 묻는다.
      allow list: if isSpaceMember(resource.data);

      // 만들 때는 내가 주인이고 나 혼자 구성원이다.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner'
        && (
          (isMySpaceId(sid) && request.resource.data.kind == 'personal')
          || (sid.matches('g_.+') && request.resource.data.kind == 'group')
        );

      allow update: if (
          // 주인: 무엇이든 고친다. 다만 종류·주인은 그대로, 주인은 늘 'owner',
          // 개인 공간은 구성원도 그대로(나 혼자). 그룹 구성원은 빼기만 - 남을 넣지 못한다
          // (P15-1 - 그러면 '같은 그룹 = 스스로 들어온 사람'이라 쪽지를 동의 없이 받지 않는다. 앱은 남을 넣지 않는다).
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.members[request.auth.uid] == 'owner'
          && resource.data.members.keys().hasAll(request.resource.data.members.keys())
          && (resource.data.kind == 'group' || request.resource.data.members == resource.data.members)
        ) || (
          // 그 밖의 사람: 그룹에서 '나'만 넣거나 뺀다(참여·나가기).
          // 참여할 때 낸 코드는 joinCodes.<나>에 적는다(P14-1) - 칸 하나(joinCode)면 앞사람이 남긴 맞는 코드로
          // 코드를 모르는 사람이 members만 써도 통과한다(request.resource.data는 고친 뒤 문서 전체).
          signedIn()
          && resource.data.kind == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt', 'joinCodes'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('joinCodes', {}).diff(resource.data.get('joinCodes', {})).affectedKeys().hasOnly([request.auth.uid])
          && (
            // 참여: 내 칸에 적은 코드 == 지금 열린 초대 코드(주인이 inviteCode를 지우거나 바꾸면 옛 코드는 막힌다), 'member'로만
            (resource.data.get('inviteCode', null) != null
              && request.resource.data.get('joinCodes', {}).get(request.auth.uid, null) == resource.data.inviteCode
              && !(request.auth.uid in resource.data.members)
              && request.resource.data.members[request.auth.uid] == 'member')
            // 나가기: 구성원이 나를 뺀다(주인은 나가지 못한다 - 그룹을 지운다)
            || (resource.data.members[request.auth.uid] == 'member'
              && !(request.auth.uid in request.resource.data.members))
          )
        );

      // 그룹은 주인만 지운다(아래 자료를 먼저 비운다). 개인 공간 문서는 지우지 않는다.
      allow delete: if signedIn()
        && resource.data.kind == 'group'
        && resource.data.ownerId == request.auth.uid;
    }

    // 공간 아래 자료에 들어갈 수 있나. 개인 공간은 이름만 보고(문서 읽기 없음), 그룹은 공간 문서의 members를 본다.
    function canUseSpace(sid) {
      return isMySpaceId(sid)
        || (sid.matches('g_.+')
          && isSpaceMember(get(/databases/$(database)/documents/spaces/$(sid)).data));
    }

    // 항목·라벨의 모양 (V5 저장 도우미 src/data/repo가 붙이는 칸). 지나치게 막지 않는다 - 종류·지운 표시·판·서버 시각만.
    // updatedAt이 서버 시각이어야 기기 사본(P2-2)이 '바뀐 것만 받기'로 이 쓰기를 놓치지 않는다
    // (기기 시각이거나 칸만 고치고 updatedAt을 빠뜨리면 다른 기기에 영영 가지 않는다 - 여기서 막아 저장 실패로 드러낸다).
    function validTracked(d) {
      return d.kind in ['event', 'note']
        && 'deletedAt' in d && (d.deletedAt == null || d.deletedAt is timestamp)
        && d.v is int && d.v >= 1
        && d.updatedAt == request.time;
    }

    // 공간 아래 자료(items·labels·settings …).
    // ⚠️ 공간 문서 자신이 걸리지 않게 하위 컬렉션 이름 자리 {sub}를 둔다(재귀 와일드카드는 빈 경로도 받아 공간 문서까지 걸린다 -
    //    그러면 구성원 누구나 그룹을 지울 수 있다. V4 groups 규칙에서 점검이 잡은 구멍).
    // ⚠️ 같은 문서에 맞는 match가 여럿이면 하나라도 허락하면 된다 - 그래서 컬렉션마다 match를 따로 두지 않고 여기서 가른다.
    match /spaces/{sid}/{sub}/{document=**} {
      allow read, delete: if canUseSpace(sid);
      allow create, update: if canUseSpace(sid)
        && (!(sub in ['items', 'labels']) || validTracked(request.resource.data));
    }

    // 초대 코드 → 그룹 공간. 코드를 아는 사람만 하나 읽는다(목록으로 훑지 못한다).
    // 만들기·고치기는 그 그룹의 주인만(같은 묶음 쓰기에서 그룹을 만들어도 되게 getAfter).
    match /spaceInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.sid)).data.kind == 'group'
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.sid)).data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.sid)).data.kind == 'group'
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.sid)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 서버 푸시 알림 큐. 함수(관리자 권한)만 읽고 쓴다 - 앱은 막는다.
    match /v5alarms/{itemId} {
      allow read, write: if false;
    }

    // 오류 알림(P14-2 - src/data/errorReport.ts). 로그인한 사람은 제 오류를 하나씩 만들기만, 읽기·지우기는 개발자만.
    // 칸과 길이는 src/domain/errorReport.ts LIMITS와 같게 - 글 내용은 앱이 지운 뒤 보낸다. 만든 뒤 고치지 않는다.
    // expireAt은 콘솔 TTL 정책이 지난 것을 지운다(30일).
    match /v5Errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'message', 'stack', 'note', 'build', 'scope', 'device', 'standalone', 'ua', 'uid', 'at', 'expireAt'])
        && request.resource.data.keys().hasAll(['kind', 'message', 'stack', 'note', 'build', 'scope', 'device', 'standalone', 'ua', 'uid', 'at', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['error', 'rejection', 'react', 'toast']
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.build is string && request.resource.data.build.size() <= 40
        && request.resource.data.scope is string && request.resource.data.scope.size() <= 40
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.device in ['pc', 'mobile']
        && request.resource.data.standalone is bool
        && request.resource.data.at == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(32, 'd');
      allow read, delete: if isDeveloper();
      allow update: if false;
    }

    // 쪽지(P15 - src/data/mail.ts). 같은 그룹(spaces/{sid}) 구성원끼리만.
    // 받는 사람마다 v5Mail/{받는 uid}/mailIn/{id} 한 장 + 보낸 사람 사본 v5Mail/{나}/mailSent/{id} - 앱이 같은 id로 한 묶음에 쓴다.
    // 묶음 안에서 같은 문서 get은 한 번으로 센다(서로 다른 문서는 20개까지 - P15-1 ■0 에뮬레이터) - 받는 사람이 많아도 그룹 문서·사본 둘.
    // 칸과 길이는 src/domain/mail.ts MAIL_LIMITS와 같게. expireAt은 콘솔 TTL 정책(컬렉션 그룹 mailIn·mailSent)이 지난 것을 지운다(1년).
    // 상자 이름 mailIn·mailSent는 DB 전체에서 고유하게(TTL 정책은 컬렉션 그룹 이름마다다). v5Mail/{uid} 문서 자신과 다른 하위 컬렉션은 막힌다(match 없음).
    function mailSpace(sid) {
      return get(/databases/$(database)/documents/spaces/$(sid)).data;
    }

    // 두 상자에 같은 칸 - 그룹·받는 사람·글·서버 시각·답장·지울 날. 나와 받는 사람 모두 지금 그 그룹 구성원이어야 한다.
    // sid는 문서 칸 값이라 경로에 넣기 전에 모양부터 본다('/'가 든 값이 다른 문서를 가리키지 않게).
    function validMail(d) {
      return d.sid is string && d.sid.matches('g_[A-Za-z0-9]+')
        && d.to is list && d.to.size() >= 1 && d.to.size() <= 50
        && !(request.auth.uid in d.to)
        && d.toNames is string && d.toNames.size() <= 600
        && d.text is string && d.text.size() <= 2000
        // 첨부(P16 - 보낸 사람 드라이브의 붙임 목록)는 있을 때만, 1~10개. 첨부가 있으면 글은 비어도 된다.
        // 목록 안 칸은 규칙이 보지 못한다 - 앱이 읽을 때 https 주소만 받는다(domain/mail readMailAttachments).
        && (d.text.size() >= 1 || 'attachments' in d)
        && (!('attachments' in d) || (d.attachments is list && d.attachments.size() >= 1 && d.attachments.size() <= 10))
        && d.groupName is string
        && d.at == request.time
        && (d.replyTo == null || (d.replyTo is string && d.replyTo.size() <= 40))
        && d.expireAt is timestamp && d.expireAt < request.time + duration.value(370, 'd')
        && d.v == 1
        && mailSpace(d.sid).kind == 'group'
        && mailSpace(d.sid).members.get(request.auth.uid, null) in ['owner', 'member']
        && mailSpace(d.sid).members.keys().hasAll(d.to)
        // 그룹 이름 = 그 공간 이름(꾸미지 못한다). 이름이 빈 공간만 앱이 보이는 이름('공유 그룹' 등 60자까지)
        && (d.groupName == mailSpace(d.sid).get('name', '')
          || (mailSpace(d.sid).get('name', '') == '' && d.groupName.size() <= 60));
    }

    match /v5Mail/{owner}/mailIn/{id} {
      // 보내는 사람이 만든다: from = 나, 이 상자 주인은 받는 사람 중 하나, 같은 id의 내 사본이 같은 묶음에 있다.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'sid', 'groupName', 'to', 'toNames', 'text', 'at', 'readAt', 'replyTo', 'attachments', 'expireAt', 'v'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'sid', 'groupName', 'to', 'toNames', 'text', 'at', 'readAt', 'replyTo', 'expireAt', 'v'])
        && request.resource.data.from == request.auth.uid
        && owner in request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.readAt == null
        && validMail(request.resource.data)
        && existsAfter(/databases/$(database)/documents/v5Mail/$(request.auth.uid)/mailSent/$(id));
      allow get, list, delete: if signedIn() && request.auth.uid == owner;
      // 주인이 읽음 표시만 - 서버 시각, 이미 읽은 것도 다시 적을 수 있다(두 기기가 함께 펼쳐도 거부 없게).
      allow update: if signedIn() && request.auth.uid == owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
    }

    match /v5Mail/{owner}/mailSent/{id} {
      allow create: if signedIn() && request.auth.uid == owner
        && request.resource.data.keys().hasOnly(['sid', 'groupName', 'to', 'toNames', 'text', 'at', 'replyTo', 'attachments', 'expireAt', 'v'])
        && request.resource.data.keys().hasAll(['sid', 'groupName', 'to', 'toNames', 'text', 'at', 'replyTo', 'expireAt', 'v'])
        && validMail(request.resource.data);
      allow get, list, delete: if signedIn() && request.auth.uid == owner;
      allow update: if false;
    }

    // 대화(P19 - src/data/chat.ts). 같은 그룹 구성원끼리 - 방 문서 하나 + 그 아래 글(chatMsgs)을 구성원이 함께 읽는다.
    //   그룹 방 v5Chat/{sid}/chatRooms/{roomId}: 'all' = 그룹 전체(지금 구성원 모두) · 'r_…' = 고른 사람 방(members).
    //   1:1 방 v5Dm/{pairId}: 'd_' + 두 uid를 작은 것부터 '_'로 - 함께 든 그룹 sid를 들고, 보낼 때 두 사람이 그 그룹 구성원인지 본다.
    //   내 읽음(그룹 방) v5ChatReads/{uid}: { rooms: { '<sid>~<roomId>': 서버 시각 } } - 나만.
    // 글 하나 = 글 + 방 미리 보기(last*) 한 묶음 - 글은 방 lastId가 자기인지, 방은 그 글이 이 요청에서 쓰였는지(at == request.time) 서로 본다.
    // 칸과 길이는 src/domain/chat.ts CHAT_LIMITS와 같게. expireAt은 TTL 정책(컬렉션 그룹 chatRooms·chatMsgs·v5Dm)이 지운다(1년 - 방은 글마다 늘어난다).
    // 지우기 규칙은 없다(TTL) - 내 글 지우기는 '지운 글'(deletedAt + 빈 글)로 고치기. v5Chat/{sid} 문서 자신과 다른 하위 컬렉션은 막힌다(match 없음).
    // ⚠️ 경로에 글자를 이을 때 '/'가 든 글자를 $( )에 넣으면 한 칸이 된다 → path('…' + …)(P19-1 ■0).

    // 그룹 sid(경로 값)의 지금 구성원인가 - canUseSpace에서 개인 공간 갈래를 뺀 것
    function chatGroupOk(sid) {
      return signedIn() && sid.matches('g_[A-Za-z0-9]+')
        && isSpaceMember(get(/databases/$(database)/documents/spaces/$(sid)).data);
    }

    // 글 모양 - 첨부는 쪽지(P16)와 같다(있을 때만 1~10개, 있으면 글은 비어도 된다)
    function validChatMsg(d) {
      return d.keys().hasOnly(['from', 'fromName', 'text', 'attachments', 'at', 'expireAt', 'v'])
        && d.keys().hasAll(['from', 'fromName', 'text', 'at', 'expireAt', 'v'])
        && d.from == request.auth.uid
        && d.fromName is string && d.fromName.size() <= 40
        && d.text is string && d.text.size() <= 2000
        && (d.text.size() >= 1 || 'attachments' in d)
        && (!('attachments' in d) || (d.attachments is list && d.attachments.size() >= 1 && d.attachments.size() <= 10))
        && d.at == request.time
        && d.expireAt is timestamp && d.expireAt < request.time + duration.value(370, 'd')
        && d.v == 1;
    }

    // 방 미리 보기 칸(r = 쓴 뒤 방) - 이 요청에서 내가 쓴 글 msgs/{lastId}가 함께 있다(옛 글 id로 미리 보기만 꾸미지 못한다).
    // expireAt은 1년 안팎 - 짧게 적어 남의 방을 TTL로 지우지 못한다.
    function chatLastOk(r, msgs) {
      return r.lastId is string
        && r.lastAt == request.time
        && r.lastFrom == request.auth.uid
        && r.lastFromName is string && r.lastFromName.size() <= 40
        && r.lastText is string && r.lastText.size() <= 80
        && r.expireAt is timestamp
        && r.expireAt > request.time + duration.value(360, 'd')
        && r.expireAt < request.time + duration.value(370, 'd')
        && getAfter(path('/databases/' + database + '/documents/' + msgs + '/' + r.lastId)).data.at == request.time;
    }

    // 내 글을 '지운 글'로 - 마지막 글이면 같은 묶음에서 방 미리 보기도 빈 글로(아래 chatLastCleared)
    function chatMsgCleared() {
      return resource.data.from == request.auth.uid
        && !('deletedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'text', 'attachments'])
        && request.resource.data.deletedAt == request.time
        && request.resource.data.text == ''
        && !('attachments' in request.resource.data);
    }
    function chatLastCleared(msgs) {
      return chatOnly(['lastText'])
        && request.resource.data.lastText == ''
        && resource.data.lastFrom == request.auth.uid
        && getAfter(path('/databases/' + database + '/documents/' + msgs + '/' + resource.data.lastId)).data.get('deletedAt', null) == request.time;
    }

    function chatOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 맵 칸(muted·reads·names)에서 내 칸만 바뀐다
    function chatMineOnly(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    function chatLastKeys() {
      return ['lastId', 'lastAt', 'lastFrom', 'lastFromName', 'lastText', 'expireAt'];
    }

    match /v5Chat/{sid}/chatRooms/{roomId} {
      // all은 구성원이면(없는 방도 get = 없음), 고른 사람 방은 그 방 사람만. 목록은 where('members.<나>', '==', true)로만.
      allow get: if chatGroupOk(sid) && (roomId == 'all' || resource.data.members[request.auth.uid] == true);
      allow list: if chatGroupOk(sid) && resource.data.members[request.auth.uid] == true;
      // 첫 글과 함께 만든다. all = 늘 같은 모양(둘이 함께 첫 글을 보내면 하나는 고치기로 지나간다), 고른 사람 방 = 이름·사람(그 그룹 구성원 2~50)
      allow create: if chatGroupOk(sid)
        && request.resource.data.v == 1
        && chatLastOk(request.resource.data, 'v5Chat/' + sid + '/chatRooms/' + roomId + '/chatMsgs')
        && ((roomId == 'all' && request.resource.data.kind == 'all'
              && request.resource.data.keys().hasOnly(['kind', 'lastId', 'lastAt', 'lastFrom', 'lastFromName', 'lastText', 'expireAt', 'v']))
          || (roomId.matches('r_[A-Za-z0-9]+') && request.resource.data.kind == 'room'
              && request.resource.data.keys().hasOnly(['kind', 'name', 'members', 'lastId', 'lastAt', 'lastFrom', 'lastFromName', 'lastText', 'expireAt', 'v'])
              && request.resource.data.name is string && request.resource.data.name.size() <= 40
              && request.resource.data.members is map
              && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50
              && request.resource.data.members[request.auth.uid] == true
              && get(/databases/$(database)/documents/spaces/$(sid)).data.members.keys().hasAll(request.resource.data.members.keys())));
      // 보내기 · 🔕 내 칸 · 내 글 지우기의 미리 보기 · (고른 사람 방) 이름 · 그 그룹 사람 더하기 · 나 빼기(나가기). 남을 빼지 못한다.
      allow update: if chatGroupOk(sid)
        && (roomId == 'all' || resource.data.members[request.auth.uid] == true)
        && (
          (chatOnly(chatLastKeys()) && chatLastOk(request.resource.data, 'v5Chat/' + sid + '/chatRooms/' + roomId + '/chatMsgs'))
          || (chatOnly(['muted']) && chatMineOnly('muted'))
          || chatLastCleared('v5Chat/' + sid + '/chatRooms/' + roomId + '/chatMsgs')
          || (resource.data.kind == 'room' && chatOnly(['name'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 40)
          || (resource.data.kind == 'room' && chatOnly(['members'])
            && request.resource.data.members.size() <= 50
            && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
            && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
            && get(/databases/$(database)/documents/spaces/$(sid)).data.members.keys().toSet()
              .hasAll(request.resource.data.members.diff(resource.data.members).addedKeys()))
          || (resource.data.kind == 'room' && chatOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in request.resource.data.members))
        );
      allow delete: if false;

      match /chatMsgs/{mid} {
        allow read: if chatGroupOk(sid)
          && (roomId == 'all' || get(/databases/$(database)/documents/v5Chat/$(sid)/chatRooms/$(roomId)).data.members[request.auth.uid] == true);
        // 방 쪽 규칙이 같은 묶음의 방 고치기(사람·미리 보기)를 본다 - 여기서는 그 방 lastId가 이 글인지만
        allow create: if chatGroupOk(sid)
          && validChatMsg(request.resource.data)
          && getAfter(/databases/$(database)/documents/v5Chat/$(sid)/chatRooms/$(roomId)).data.lastId == mid
          && getAfter(/databases/$(database)/documents/v5Chat/$(sid)/chatRooms/$(roomId)).data.lastAt == request.time;
        allow update: if chatGroupOk(sid)
          && (roomId == 'all' || get(/databases/$(database)/documents/v5Chat/$(sid)/chatRooms/$(roomId)).data.members[request.auth.uid] == true)
          && chatMsgCleared();
        allow delete: if false;
      }
    }

    // 1:1 방 id = 'd_' + 작은 uid + '_' + 큰 uid, 나는 그 둘 중 하나, members는 그 둘만 true
    function dmPairOk(pairId, members) {
      let p = pairId.split('_');
      return p.size() == 3 && p[0] == 'd' && p[1] < p[2]
        && (p[1] == request.auth.uid || p[2] == request.auth.uid)
        && members is map && members.size() == 2 && members.keys().hasOnly([p[1], p[2]])
        && members[p[1]] == true && members[p[2]] == true;
    }
    // 방이 든 그룹 sid(문서 칸 값 - 모양부터)에 두 사람 모두 지금 구성원이다
    function dmGroupOk(d) {
      return d.sid is string && d.sid.matches('g_[A-Za-z0-9]+')
        && get(/databases/$(database)/documents/spaces/$(d.sid)).data.kind == 'group'
        && get(/databases/$(database)/documents/spaces/$(d.sid)).data.members.keys().hasAll(d.members.keys());
    }

    match /v5Dm/{pairId} {
      // 두 사람만 - 그룹을 나가도 지난 글은 읽는다(쪽지 받은 것이 남듯). 보내기는 함께 든 그룹이 있을 때만.
      allow get, list: if signedIn() && resource.data.members[request.auth.uid] == true;
      // 만들기와 보내기가 같은 모양(names는 내 칸만) - 둘이 함께 첫 글을 보내도 하나는 고치기로 지나간다
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'members', 'sid', 'names', 'lastId', 'lastAt', 'lastFrom', 'lastFromName', 'lastText', 'expireAt', 'v'])
        && request.resource.data.kind == 'dm' && request.resource.data.v == 1
        && dmPairOk(pairId, request.resource.data.members)
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] is string && request.resource.data.names[request.auth.uid].size() <= 40
        && dmGroupOk(request.resource.data)
        && chatLastOk(request.resource.data, 'v5Dm/' + pairId + '/chatMsgs');
      // 보내기(함께 든 다른 그룹으로 sid 옮기기·내 이름 포함) · 🔕 내 칸 · 읽음 내 칸(서버 시각) · 내 글 지우기의 미리 보기
      allow update: if signedIn() && resource.data.members[request.auth.uid] == true
        && (
          (chatOnly(['lastId', 'lastAt', 'lastFrom', 'lastFromName', 'lastText', 'expireAt', 'sid', 'names'])
            && chatMineOnly('names')
            && request.resource.data.names[request.auth.uid] is string && request.resource.data.names[request.auth.uid].size() <= 40
            && dmGroupOk(request.resource.data)
            && chatLastOk(request.resource.data, 'v5Dm/' + pairId + '/chatMsgs'))
          || (chatOnly(['muted']) && chatMineOnly('muted'))
          || (chatOnly(['reads']) && chatMineOnly('reads') && request.resource.data.reads[request.auth.uid] == request.time)
          || chatLastCleared('v5Dm/' + pairId + '/chatMsgs')
        );
      allow delete: if false;

      match /chatMsgs/{mid} {
        allow read: if signedIn() && get(/databases/$(database)/documents/v5Dm/$(pairId)).data.members[request.auth.uid] == true;
        allow create: if signedIn()
          && validChatMsg(request.resource.data)
          && getAfter(/databases/$(database)/documents/v5Dm/$(pairId)).data.members[request.auth.uid] == true
          && getAfter(/databases/$(database)/documents/v5Dm/$(pairId)).data.lastId == mid
          && getAfter(/databases/$(database)/documents/v5Dm/$(pairId)).data.lastAt == request.time;
        allow update: if signedIn()
          && get(/databases/$(database)/documents/v5Dm/$(pairId)).data.members[request.auth.uid] == true
          && chatMsgCleared();
        allow delete: if false;
      }
    }

    // 내 읽음(그룹 방) - 나만 읽고 쓴다. 바뀐 칸 값이 서버 시각인지는 규칙이 보지 못한다(Set에서 꺼낼 수 없다 - 나만 보는 것이라 둔다).
    match /v5ChatReads/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rooms', 'v'])
        && request.resource.data.rooms is map && request.resource.data.rooms.size() <= 2000;
    }

  }
}
